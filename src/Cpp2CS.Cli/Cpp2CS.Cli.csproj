<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Cpp2CS.Cli</RootNamespace>
    <AssemblyName>cpp2cs</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- 恢复是一次性批处理，PGO 插桩的开销收不回来。 -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Cpp2CS.Pipeline/Cpp2CS.Pipeline.csproj" />
    <ProjectReference Include="../Cpp2CS.Core/Cpp2CS.Core.csproj" />
    <ProjectReference Include="../Cpp2CS.Input/Cpp2CS.Input.csproj" />
    <ProjectReference Include="../Cpp2CS.Output/Cpp2CS.Output.csproj" />
  </ItemGroup>

</Project>
